@model SistemaLavanderia.Models.PedidoCreateViewModel

@{
    ViewData["Title"] = "Solicitar Serviço de Lavanderia";
}

<div class="container mt-4 pedido-page">
    <h1 class="pedido-title">Solicitar Serviço de Lavanderia</h1>

    <form asp-action="Create" method="post" id="pedidoForm">
        <input asp-for="ClienteId" type="hidden" />
        <input asp-for="UsuarioId" type="hidden" />
        <input asp-for="Status" type="hidden" />

        <!-- campos ocultos que o JS vai preencher -->
        <input asp-for="Camisa" type="hidden" id="hiddenCamisa" />
        <input asp-for="Calca" type="hidden" id="hiddenCalca" />
        <input asp-for="Jaqueta" type="hidden" id="hiddenJaqueta" />
        <input asp-for="Toalha" type="hidden" id="hiddenToalha" />
        <input asp-for="Lencol" type="hidden" id="hiddenLencol" />
        <input asp-for="Cobertor" type="hidden" id="hiddenCobertor" />
        <input asp-for="Edredom" type="hidden" id="hiddenEdredom" />
        <input asp-for="Outros" type="hidden" id="hiddenOutros" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            <!-- COLUNA ESQUERDA -->
            <div class="col-lg-8">
                <div class="card custom-card mb-4">
                    <div class="card-header custom-header-blue">
                        <i class="bi bi-info-circle-fill"></i> Dados do Pedido
                    </div>
                    <div class="card-body">
                        <div class="client-box mb-3">
                            <strong><i class="bi bi-person-fill"></i> Cliente:</strong> @ViewBag.NomeClienteLogado
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="TipoLavagem" class="form-label fw-semibold">Tipo de Serviço</label>
                                <select asp-for="TipoLavagem" class="form-select">
                                    <option value="">Selecione o tipo de serviço</option>
                                    <option value="Lavagem Simples">Lavagem Simples (água e sabão)</option>
                                    <option value="Lavagem a Seco">Lavagem a Seco (produtos especiais)</option>
                                    <option value="Passadoria">Passadoria (roupas passadas)</option>
                                    <option value="Lavagem Pesada">Lavagem Pesada (roupas muito sujas)</option>
                                    <option value="Tinturaria">Tinturaria (tingimento e restauração)</option>
                                </select>
                                <span asp-validation-for="TipoLavagem" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DataEntrega" class="form-label fw-semibold">Data desejada para entrega</label>
                                <input asp-for="DataEntrega" type="date" class="form-control" />
                                <span asp-validation-for="DataEntrega" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="itens-wrapper">
                            <div class="itens-header">
                                <i class="bi bi-tshirt"></i> Itens do Pedido
                            </div>

                            <div id="itensContainer" class="p-3"></div>

                            <div class="px-3 pb-3">
                                <button type="button" class="btn btn-success" id="btnAdicionarItem">
                                    <i class="bi bi-plus-lg"></i> Adicionar Peça
                                </button>
                            </div>
                        </div>

                        <div class="resumo-wrapper mt-3">
                            <div class="resumo-header">
                                <i class="bi bi-receipt"></i> Resumo
                            </div>
                            <div class="resumo-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>Valor Total:</strong>
                                    <span id="valorTotal" class="valor-total">R$ 0,00</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-semibold">Observações</label>
                            <textarea class="form-control" rows="3" placeholder="Observações adicionais..."></textarea>
                        </div>

                        <div class="mt-4 d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle-fill"></i> Finalizar Pedido
                            </button>

                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUNA DIREITA -->
            <div class="col-lg-4">
                <div class="card custom-card mb-4">
                    <div class="card-header custom-header-yellow">
                        <i class="bi bi-clock-fill"></i> Prazos
                    </div>
                    <div class="card-body">
                        <ul class="prazo-list">
                            <li>✅ Lavagem Simples: 2 dias</li>
                            <li>✅ Lavagem a Seco: 3 dias</li>
                            <li>✅ Passadoria: 1 dia</li>
                            <li>✅ Tinturaria: 5 dias</li>
                        </ul>
                    </div>
                </div>

                <div class="card custom-card">
                    <div class="card-header custom-header-cyan">
                        <i class="bi bi-tag-fill"></i> Tabela de Preços
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Peça</th>
                                    <th>Simples</th>
                                    <th>Seco</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Camisa</td><td>R$ 8</td><td>R$ 15</td></tr>
                                <tr><td>Calça</td><td>R$ 10</td><td>R$ 18</td></tr>
                                <tr><td>Vestido</td><td>R$ 15</td><td>R$ 25</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-none">
            <input asp-for="DataEntrada" type="date" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const precos = {
            "Camisa": 8.00,
            "Calca": 10.00,
            "Jaqueta": 18.00,
            "Toalha": 6.00,
            "Lencol": 12.00,
            "Cobertor": 25.00,
            "Edredom": 35.00,
            "Outros": 10.00
        };

        const itensContainer = document.getElementById("itensContainer");
        const btnAdicionarItem = document.getElementById("btnAdicionarItem");
        const valorTotal = document.getElementById("valorTotal");

        function formatarMoeda(valor) {
            return valor.toLocaleString("pt-BR", {
                style: "currency",
                currency: "BRL"
            });
        }

        function criarLinhaItem(tipo = "", quantidade = 1) {
            const row = document.createElement("div");
            row.className = "item-card";

            row.innerHTML = `
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Tipo de Roupa</label>
                        <select class="form-select item-tipo">
                            <option value="">Selecione...</option>
                            <option value="Camisa">Camisa - R$ 8,00</option>
                            <option value="Calca">Calça - R$ 10,00</option>
                            <option value="Jaqueta">Jaqueta - R$ 18,00</option>
                            <option value="Toalha">Toalha - R$ 6,00</option>
                            <option value="Lencol">Lençol - R$ 12,00</option>
                            <option value="Cobertor">Cobertor - R$ 25,00</option>
                            <option value="Edredom">Edredom - R$ 35,00</option>
                            <option value="Outros">Outros - R$ 10,00</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Quantidade</label>
                        <input type="number" class="form-control item-quantidade" min="1" value="${quantidade}">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Subtotal</label>
                        <div class="subtotal-text">R$ 0,00</div>
                    </div>

                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-danger btn-remover">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </div>
            `;

            const select = row.querySelector(".item-tipo");
            const inputQtd = row.querySelector(".item-quantidade");
            const subtotalText = row.querySelector(".subtotal-text");
            const btnRemover = row.querySelector(".btn-remover");

            if (tipo) {
                select.value = tipo;
            }

            function atualizarSubtotal() {
                const tipoSelecionado = select.value;
                const qtd = parseInt(inputQtd.value) || 0;
                const preco = precos[tipoSelecionado] || 0;
                const subtotal = qtd * preco;
                subtotalText.textContent = formatarMoeda(subtotal);
                atualizarResumo();
            }

            select.addEventListener("change", atualizarSubtotal);
            inputQtd.addEventListener("input", atualizarSubtotal);

            btnRemover.addEventListener("click", function () {
                row.remove();
                atualizarResumo();
            });

            atualizarSubtotal();
            itensContainer.appendChild(row);
        }

        function atualizarResumo() {
            const cards = document.querySelectorAll(".item-card");

            let total = 0;
            let totais = {
                Camisa: 0,
                Calca: 0,
                Jaqueta: 0,
                Toalha: 0,
                Lencol: 0,
                Cobertor: 0,
                Edredom: 0,
                Outros: 0
            };

            cards.forEach(card => {
                const tipo = card.querySelector(".item-tipo").value;
                const qtd = parseInt(card.querySelector(".item-quantidade").value) || 0;

                if (tipo && totais.hasOwnProperty(tipo)) {
                    totais[tipo] += qtd;
                    total += qtd * (precos[tipo] || 0);
                }
            });

            valorTotal.textContent = formatarMoeda(total);

            document.getElementById("hiddenCamisa").value = totais.Camisa;
            document.getElementById("hiddenCalca").value = totais.Calca;
            document.getElementById("hiddenJaqueta").value = totais.Jaqueta;
            document.getElementById("hiddenToalha").value = totais.Toalha;
            document.getElementById("hiddenLencol").value = totais.Lencol;
            document.getElementById("hiddenCobertor").value = totais.Cobertor;
            document.getElementById("hiddenEdredom").value = totais.Edredom;
            document.getElementById("hiddenOutros").value = totais.Outros;
        }

        btnAdicionarItem.addEventListener("click", function () {
            criarLinhaItem();
        });

    </script>
}