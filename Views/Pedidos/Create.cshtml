@model SistemaLavanderia.Models.PedidoCreateViewModel

@{
    var perfil = ViewBag.Perfil as string;
    var nomeClienteLogado = ViewBag.NomeClienteLogado as string;
}

<h2>@(perfil == "Administrador" ? "Novo Pedido" : "Nova Solicitação de Lavagem")</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="mb-3">Tabela de preços estimados por peça</h4>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Peça</th>
                            <th>Valor unitário</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Camisa</td><td>R$ 8,00</td></tr>
                        <tr><td>Calça</td><td>R$ 10,00</td></tr>
                        <tr><td>Jaqueta</td><td>R$ 18,00</td></tr>
                        <tr><td>Toalha</td><td>R$ 6,00</td></tr>
                        <tr><td>Lençol</td><td>R$ 12,00</td></tr>
                        <tr><td>Cobertor</td><td>R$ 25,00</td></tr>
                        <tr><td>Edredom</td><td>R$ 35,00</td></tr>
                        <tr><td>Outros</td><td>R$ 10,00</td></tr>
                    </tbody>
                </table>
            </div>
            <small class="text-muted">
                O valor total será calculado automaticamente com base nas peças e quantidades informadas.
            </small>
        </div>
    </div>

    @if (perfil == "Administrador")
    {
        <div class="form-group mb-3">
            <label asp-for="ClienteId">Cliente</label>
            <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
            <span asp-validation-for="ClienteId" class="text-danger"></span>
        </div>
    }
    else
    {
        <div class="form-group mb-3">
            <label>Cliente</label>
            <input type="text" class="form-control" value="@nomeClienteLogado" readonly />
            <input type="hidden" asp-for="ClienteId" />
        </div>
    }

    <div class="form-group mb-3">
        <label asp-for="TipoLavagem">Tipo de Lavagem</label>
        <select asp-for="TipoLavagem" class="form-control">
            <option value="">Selecione</option>
            <option value="Lavagem Comum">Lavagem Comum</option>
            <option value="Lavagem a Seco">Lavagem a Seco</option>
            <option value="Especial">Especial</option>
        </select>
        <span asp-validation-for="TipoLavagem" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="Camisa">Camisa</label>
            <input asp-for="Camisa" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Calca">Calça</label>
            <input asp-for="Calca" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Jaqueta">Jaqueta</label>
            <input asp-for="Jaqueta" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Toalha">Toalha</label>
            <input asp-for="Toalha" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Lencol">Lençol</label>
            <input asp-for="Lencol" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Cobertor">Cobertor</label>
            <input asp-for="Cobertor" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Edredom">Edredom</label>
            <input asp-for="Edredom" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Outros">Outros</label>
            <input asp-for="Outros" class="form-control" />
        </div>
    </div>

    @if (perfil == "Administrador")
    {
        <div class="form-group mb-3">
            <label asp-for="Status"></label>
            <select asp-for="Status" class="form-control">
                <option value="Recebido">Recebido</option>
                <option value="Em Lavagem">Em Lavagem</option>
                <option value="Pronto">Pronto</option>
                <option value="Entregue">Entregue</option>
            </select>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="Status" value="Recebido" />
    }

    <div class="form-group mb-3">
        <label asp-for="DataEntrada">Data de Entrada</label>
        <input asp-for="DataEntrada" class="form-control" type="date" />
    </div>

    @if (perfil == "Administrador")
    {
        <div class="form-group mb-3">
            <label asp-for="DataEntrega">Data de Entrega</label>
            <input asp-for="DataEntrega" class="form-control" type="date" />
        </div>
    }

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}