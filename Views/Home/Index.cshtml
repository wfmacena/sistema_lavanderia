@model SistemaLavanderia.Models.DashboardViewModel

<div class="text-center mb-4">
    <h1 class="display-4">Sistema de Lavanderia</h1>
    <p>Dashboard geral do sistema</p>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card text-center shadow border-0">
            <div class="card-body">
                <h5 class="card-title">Clientes</h5>
                <p class="card-text fs-2">@Model.TotalClientes</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center shadow border-0">
            <div class="card-body">
                <h5 class="card-title">Pedidos</h5>
                <p class="card-text fs-2">@Model.TotalPedidos</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center shadow border-0">
            <div class="card-body">
                <h5 class="card-title">Recebidos</h5>
                <p class="card-text fs-2">@Model.PedidosRecebidos</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center shadow border-0">
            <div class="card-body">
                <h5 class="card-title">Em Lavagem</h5>
                <p class="card-text fs-2">@Model.PedidosEmLavagem</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center shadow border-0">
            <div class="card-body">
                <h5 class="card-title">Prontos</h5>
                <p class="card-text fs-2">@Model.PedidosProntos</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center shadow border-0">
            <div class="card-body">
                <h5 class="card-title">Entregues</h5>
                <p class="card-text fs-2">@Model.PedidosEntregues</p>
            </div>
        </div>
    </div>
</div>