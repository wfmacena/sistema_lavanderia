@{
    ViewData["Title"] = "Welcome";
}

<div class="welcome-page">
    <section class="welcome-hero">
        <div class="welcome-hero-content">
            <span class="welcome-badge">Sistema moderno para gestão de lavanderia</span>

            <h1>Controle total da sua lavanderia</h1>

            <p>
                Organize pedidos, acompanhe lavagens, visualize clientes e tenha
                uma gestão profissional e moderna.
            </p>

            <div class="welcome-actions">
                <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg">
                    Entrar no sistema
                </a>

                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                    Criar minha conta
                </a>
            </div>
        </div>

        <div class="welcome-how-card">
            <h3>Como funciona</h3>

            <div class="how-item">
                <span>Pedido recebido</span>
                <span class="status-pill status-gray">Recebido</span>
            </div>

            <div class="how-item">
                <span>Em lavagem</span>
                <span class="status-pill status-yellow">Lavando</span>
            </div>

            <div class="how-item">
                <span>Finalizado</span>
                <span class="status-pill status-green">Entregue</span>
            </div>
        </div>
    </section>

    <section class="welcome-features-section">
        <div class="welcome-section-title">
            <h2>Por que escolher nosso sistema?</h2>
            <p>
                Uma solução completa para gerenciar sua lavanderia com eficiência e
                profissionalismo
            </p>
        </div>

        <div class="welcome-features-grid">
            <div class="welcome-feature-card">
                <div class="feature-icon-circle">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h4>Gestão de Clientes</h4>
                <p>
                    Cadastre e gerencie todos os seus clientes com informações completas
                    e histórico de pedidos.
                </p>
            </div>

            <div class="welcome-feature-card">
                <div class="feature-icon-circle">
                    <i class="bi bi-tags-fill"></i>
                </div>
                <h4>Serviços Personalizados</h4>
                <p>
                    Configure diferentes tipos de serviços, preços e unidades de medida.
                </p>
            </div>

            <div class="welcome-feature-card">
                <div class="feature-icon-circle">
                    <i class="bi bi-clipboard-data-fill"></i>
                </div>
                <h4>Controle de Pedidos</h4>
                <p>
                    Acompanhe o status dos pedidos em tempo real: aguardando, lavando,
                    pronto ou entregue.
                </p>
            </div>

            <div class="welcome-feature-card">
                <div class="feature-icon-circle">
                    <i class="bi bi-calculator-fill"></i>
                </div>
                <h4>Cálculo Automático</h4>
                <p>
                    O sistema calcula automaticamente o valor total dos pedidos baseado
                    nos serviços selecionados.
                </p>
            </div>

            <div class="welcome-feature-card">
                <div class="feature-icon-circle">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h4>Relatórios</h4>
                <p>
                    Acompanhe o desempenho do seu negócio com relatórios detalhados.
                </p>
            </div>

            <div class="welcome-feature-card">
                <div class="feature-icon-circle">
                    <i class="bi bi-shield-fill-check"></i>
                </div>
                <h4>Segurança</h4>
                <p>
                    Sistema com autenticação e níveis de acesso para maior segurança dos dados.
                </p>
            </div>
        </div>
    </section>

    <section class="welcome-stats-section">
        <div class="welcome-stat-item">
            <h3>500+</h3>
            <p>Clientes Atendidos</p>
        </div>

        <div class="welcome-stat-item">
            <h3>1000+</h3>
            <p>Pedidos Realizados</p>
        </div>

        <div class="welcome-stat-item">
            <h3>4+</h3>
            <p>Tipos de Serviço</p>
        </div>

        <div class="welcome-stat-item">
            <h3>99%</h3>
            <p>Satisfação</p>
        </div>
    </section>

    <section class="welcome-cta-section">
        <h2>Pronto para começar?</h2>
        <p>
            Acesse agora mesmo o sistema e comece a gerenciar sua lavanderia
            de forma profissional.
        </p>

        <a asp-controller="Pedidos" asp-action="Create" class="btn btn-light btn-lg welcome-cta-btn">
            <i class="bi bi-plus-circle-fill"></i> Criar Novo Pedido
        </a>
    </section>
</div>