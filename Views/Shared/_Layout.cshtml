@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var usuarioLogin = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioLogin");
    var usuarioNome = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioNome");
    var usuarioPerfil = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioPerfil");
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaLavanderia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaLavanderia.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Welcome">
                    🧺 Lavanderia Manager
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (!string.IsNullOrEmpty(usuarioLogin))
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Início</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Servicos" asp-action="Index">Serviços</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Pedidos"
                                   asp-action="Create">
                                    Solicitar Serviços
                                </a>
                            </li>

                            @if (usuarioPerfil == "Administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Pedidos" asp-action="Index">
                                    @(usuarioPerfil == "Administrador" ? "Pedidos" : "Minhas Solicitações")
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning"
                                   href="#"
                                   id="contaDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    👤 @usuarioNome
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="contaDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Configuracoes">
                                            Configurações
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            Sair
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container mt-4">
            &copy; 2026 - SistemaLavanderia
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>